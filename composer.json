{
    "name": "seatable-public-connector/app",
    "type": "project",
    "description": "Laravel 12 TALL stack demo for receipt OCR",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "livewire/livewire": "^3.0",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/support": "^12.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    }
}
